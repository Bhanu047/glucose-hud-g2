{
  "name": "glucose-hud-g2",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "pack": "npm run build && evenhub pack app.json dist",
    "simulate": "evenhub-simulator http://localhost:5173",
    "test": "tsc src/nightscout.ts --outDir dist-test --target es2022 --module esnext --moduleResolution bundler --skipLibCheck && node --test test/*.test.mjs",
    "mock": "node mock/nightscout.mjs"
  },
  "dependencies": {
    "@evenrealities/even_hub_sdk": "^0.0.10"
  },
  "devDependencies": {
    "@evenrealities/evenhub-cli": "^0.1.12",
    "@evenrealities/evenhub-simulator": "^0.7.2",
    "typescript": "^5.7.0",
    "vite": "^5.4.0"
  }
}
